PROJECT_NAME=cajoo
PORT=3000
APP_ENV=development
APP_VERSION=dev
# Em produção, o domínio sem barra final é configurado no Compose:
# PUBLIC_ORIGIN=https://cajoo.fsw-ifc.brdrive.cloud
# Opcional, apenas ANTES da primeira inicialização:
# INITIAL_ADMIN_PASSWORD=outra_senha_inicial

# Conexão a partir do host. O Compose substitui host/porta dentro dos containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=15433
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cajoo-db
