# PROJECT_NAME: usado pelos scripts de deploy/CI.
PROJECT_NAME=cajoo

# PORT: porta interna em que o servidor de produção escuta dentro do container.
PORT=3000
APP_ENV=development
APP_VERSION=dev

# APP_URL: URL onde o site fica disponível.
APP_URL="http://localhost:3000"

# Banco de dados (Postgres) — pronto para o backend usar quando ele existir.
POSTGRES_HOST=cajoo-db
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cajoo-db
